  "type": "module",
  "main": "./src/server.ts",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "start": "node .api/server.ts",
    "build": "prisma generate && tsup src/index.ts --format esm --platform node --target node20 --outDir api --external pg-native",
    "dev": "tsx watch ./src/server.ts",
    "lint": "eslint ./src/**/*",
    "migrate": "npx prisma migrate dev",
    "generate": "npx prisma generate",
    "mig-gen": "npm run migrate && npm run generate",
    "studio": "npx prisma studio",
    "push": "npx prisma db push",
    "pull": "npx prisma db pull",
    "stripe:webhook": "stripe listen --forward-to localhost:5000/webhook"
  },
  "dependencies": {
    "@better-auth/prisma-adapter": "^1.5.3",
    "@prisma/adapter-pg": "^7.4.2",
    "@prisma/client": "^7.4.2",
    "@types/multer": "^2.1.0",
    "better-auth": "^1.5.3",
    "cloudinary": "^1.41.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "date-fns": "^4.1.0",
    "dotenv": "^17.3.1",
    "ejs": "^5.0.1",
    "express": "^5.2.1",
    "http-status": "^2.1.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.1.1",
    "multer-storage-cloudinary": "^4.0.0",
